{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "histochat",
  // "Hyun Seung Moon" account. Never deploy to the hyunini0408 account.
  "account_id": "04a2c1a992c45a03828908f19bbe9fdc",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // process.env.OPENAI_API_KEY in api/ comes from the Worker secret.
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "histochat.hyunseungmoon.net", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
